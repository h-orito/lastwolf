# Local development environment variables.
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Loaded automatically by springboot3-dotenv on startup.

# Firebase Admin SDK service account JSON path (local file path)
FIREBASE_ADMINSDK_SECRETKEY_PATH=/absolute/path/to/firebase-adminsdk.json

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
